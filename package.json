{
  "name": "tradeos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx scripts/test-db.ts && vitest run",
    "test:e2e": "playwright test",
    "test:standalone": "node scripts/standalone-smoke.mjs",
    "db:generate": "node scripts/schema-metadata.mjs && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "npm run db:generate && prisma migrate deploy",
    "postinstall": "node scripts/schema-metadata.mjs && prisma generate",
    "demo": "DATABASE_URL=file:./data/demo.db npm run db:setup && DATABASE_URL=file:./data/demo.db tsx scripts/demo.ts",
    "dev:demo": "DATABASE_URL=file:./data/demo.db next dev --hostname 127.0.0.1",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs *.json docs README.md"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "latest",
    "better-sqlite3": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "decimal.js": "latest",
    "dotenv": "latest",
    "echarts": "latest",
    "lightweight-charts": "5.2.1",
    "lucide-react": "latest",
    "next": "16.4.0",
    "papaparse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
