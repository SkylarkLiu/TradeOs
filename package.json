{
  "name": "tradeos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx scripts/test-db.ts && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/schema-metadata.mjs && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "npm run db:generate && prisma migrate deploy",
    "postinstall": "node scripts/schema-metadata.mjs && prisma generate",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "latest",
    "react-dom": "latest",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "better-sqlite3": "latest",
    "decimal.js": "latest",
    "zod": "latest",
    "zustand": "latest",
    "echarts": "latest",
    "lightweight-charts": "5.2.1",
    "lucide-react": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "tailwind-merge": "latest",
    "papaparse": "latest",
    "react-markdown": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/better-sqlite3": "latest",
    "@types/papaparse": "latest",
    "prisma": "7.10.0",
    "tsx": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "vitest": "5.0.3",
    "@playwright/test": "latest"
  }
}
